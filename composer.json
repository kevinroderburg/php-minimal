{
    "name": "kroderburg/php-minimal",
    "description": "Minimal modern PHP development template with Docker, PHP-FPM, Nginx and MariaDB",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,    
    "authors": [
        {
            "name": "Kevin Roderburg"
        }
    ],    
    "require": {
        "php": "^8.4"
    },    
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },    
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "coverage": "vendor/bin/phpunit -c phpunit.xml --coverage-html coverage",
        "fix": "vendor/bin/php-cs-fixer fix",
        "test": "vendor/bin/phpunit -c phpunit.xml"
    },   
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
